{
	"name": "slowed-reverbed",
	"private": true,
	"packageManager": "pnpm@10.33.0",
	"engines": {
		"node": ">=22 <25"
	},
	"scripts": {
		"audit": "pnpm audit --audit-level high",
		"build": "nuxt build",
		"check": "pnpm lint && pnpm typecheck && pnpm test",
		"dev": "nuxt dev",
		"generate": "nuxt generate",
		"lint": "eslint nuxt.config.ts eslint.config.mjs pages utils",
		"postinstall": "nuxt prepare",
		"preview": "node .output/server/index.mjs",
		"test": "vitest run",
		"typecheck": "nuxt typecheck",
		"agents:check": "mirket project doctor --project . && node --test scripts/harness.node.mjs"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@tailwindcss/vite": "4.3.3",
		"@types/audiobuffer-to-wav": "1.0.4",
		"eslint": "10.8.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-vue": "10.11.1",
		"globals": "17.8.0",
		"nuxt": "3.21.11",
		"prettier": "3.9.6",
		"tailwindcss": "4.3.3",
		"typescript": "5.8.3",
		"typescript-eslint": "8.65.0",
		"vitest": "4.1.11",
		"vue-eslint-parser": "10.4.1",
		"vue-tsc": "3.3.9"
	},
	"dependencies": {
		"audiobuffer-to-wav": "1.0.0",
		"tone": "14.9.17"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@parcel/watcher",
			"esbuild"
		],
		"overrides": {
			"brace-expansion": "5.0.12",
			"brace-expansion@<5.0.12": "5.0.12",
			"postcss-selector-parser@<7.1.6": "7.1.6",
			"qs@>=6.0.0 <6.16.0": "6.16.0",
			"source-map-js@<1.2.2": "1.2.2",
			"flatted@<3.4.4": "3.4.4",
			"glob@>=10.2.0 <10.5.0": "10.5.0",
			"lodash@>=4.0.0 <4.18.1": "4.18.1",
			"lodash-es@>=4.0.0 <4.18.1": "4.18.1",
			"minimatch@>=5.0.0 <5.1.8": "5.1.8",
			"minimatch@>=9.0.0 <9.0.7": "9.0.7",
			"picomatch@>=2.0.0 <2.3.2": "2.3.2",
			"picomatch@>=4.0.0 <4.0.5": "4.0.5",
			"rollup@>=4.0.0 <4.62.3": "4.62.3",
			"tar@>=7.0.0 <7.5.22": "7.5.22",
			"uuid@>=11.0.0 <11.1.1": "11.1.1"
		}
	}
}
